	column week_of_year
		dataType: int64
		formatString: 0
		lineageTag: 3a49e05e-235b-5e6c-9ce6-fc82f497a7fc
		summarizeBy: none
		sourceColumn: week_of_year

	column day_of_month
		dataType: int64
		formatString: 0
		lineageTag: 1ba6d5f3-331a-5a96-9c32-13b70c389b27
		summarizeBy: none
		sourceColumn: day_of_month

	column day_of_week
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9f8709ca-7dc2-5200-8ed6-b30a9efa2d65
		summarizeBy: none
