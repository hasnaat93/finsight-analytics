	column day_name
		dataType: string
		lineageTag: 1314839a-faf4-5cab-b3f4-de42443f2e60
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: day_of_week

	/// Fiscal year, starting 1 July
	column fiscal_year
		dataType: int64
		formatString: 0
		lineageTag: 81f4c51d-3948-5148-b152-b6493e2ff698
		summarizeBy: none
		sourceColumn: fiscal_year

	column fiscal_quarter
		dataType: int64
		formatString: 0
		lineageTag: 6f4d6a83-b8f3-59b0-9e03-cdb6f1d347c5
		summarizeBy: none
		sourceColumn: fiscal_quarter

	/// Month of the fiscal year: 1 is July
	column fiscal_period
		dataType: int64
		formatString: 0
		lineageTag: 9425bea8-c52e-5862-adb2-46f847632e93
		summarizeBy: none
