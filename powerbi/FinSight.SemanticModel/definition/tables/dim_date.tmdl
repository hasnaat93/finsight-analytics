/// Calendar. One row per day; marked as the date table.
table dim_date
	lineageTag: abdf3849-aad1-5c71-830c-ed71b1601398
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 944eea9a-7ed7-5bc1-b785-b48c8cc6e07c
		summarizeBy: none
		sourceColumn: date_key

	/// Calendar date
	column date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: 9117e540-cced-5884-a5ce-54dc99795775
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		lineageTag: b05dd95e-e591-5427-a0cb-ae801e510cd3
		summarizeBy: none
