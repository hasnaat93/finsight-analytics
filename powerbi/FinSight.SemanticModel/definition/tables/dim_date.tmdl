		isHidden
		formatString: 0
		lineageTag: a1970046-6061-54e7-b32e-7e3303235906
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: 4a05deb3-daa4-57fa-b3d1-197c49ad32c1
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	/// Year and month as yyyy-mm
	column year_month
		dataType: string
		lineageTag: f6d1a246-59b4-5414-ae69-b06dcbe01289
		summarizeBy: none
