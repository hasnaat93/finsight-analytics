/// One row per refund, in USD at the rate of the refund date.
table fact_refund
	lineageTag: 5a7f2d5d-c39b-527c-8e72-4136b6fb947d

	column refund_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 98f8134a-5215-58d9-a1c6-b32d8c6f879f
		summarizeBy: none
		sourceColumn: refund_key

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e3ca6237-2341-58fe-a87d-93ba3826f8a5
		summarizeBy: none
		sourceColumn: date_key

	column merchant_key
