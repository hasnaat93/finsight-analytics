/// One row per payment attempt. Amounts are in USD at the rate of the payment date.
table fact_transaction
	lineageTag: d8f2bd6f-3c22-5860-a64b-1fc8beb6c8fb

	column transaction_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a291e4cb-5f86-5ebf-b586-9cbf2896e057
		summarizeBy: none
		sourceColumn: transaction_key

	column date_key
