# Copy to .env. Local development defaults only; never commit real credentials.
POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_PORT=5432
FINSIGHT_DATABASE_URL=postgresql://finsight:finsight@localhost:5432/finsight
# A separate database the test suite may wipe. Create it once: createdb finsight_test
FINSIGHT_TEST_DATABASE_URL=postgresql://finsight:finsight@localhost:5432/finsight_test
